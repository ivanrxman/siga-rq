@startuml
!include _estilo.iuml
left to right direction
skinparam linetype ortho
actor Administrador
package "Interfaz" {
  boundary "PantallaAlumnos" as IA
  boundary "PantallaCompra" as IC
  boundary "PantallaVencimientos" as IV
  boundary "PantallaNewsletter" as IN
  boundary "PantallaHistorial" as IH
}
package "Control" {
  control "GestorAlumnos" as CA
  control "GestorCompras" as CC
  control "GestorVencimientos" as CV
  control "GestorNewsletter" as CN
}
package "Entidad" {
  entity "Alumno" as EA
  entity "Pack" as EP
  entity "Compra" as ECo
  entity "EdicionNewsletter" as EE
  entity "Envio" as EEn
  entity "Modulo" as EM
  entity "Avance" as EAv
}
Administrador --> IA
Administrador --> IC
Administrador --> IV
Administrador --> IN
Administrador --> IH
IA --> CA
IC --> CC
IV --> CV
IN --> CN
IH --> CN
CA --> EA
CC --> EA
CC --> EP
CC --> ECo
CV --> ECo
CN --> EE
CN --> ECo
CN --> EEn
EP --> EM
EAv --> EM
EAv --> EA
@enduml
